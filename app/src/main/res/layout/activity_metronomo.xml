<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MetronomoActivity">

    <TextView
        android:id="@+id/bpm_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="120"
        android:textSize="100sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="64dp" />

    <TextView
        android:id="@+id/label_bpm_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BPM"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/bpm_display"
        app:layout_constraintStart_toStartOf="@id/bpm_display"
        app:layout_constraintEnd_toEndOf="@id/bpm_display" />

    <SeekBar
        android:id="@+id/bpm_seekbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="240"
        android:min="40"
        android:progress="120"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/label_bpm_unit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/label_time_sig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_time_sig"
        android:textSize="16sp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bpm_seekbar" />

    <Spinner
        android:id="@+id/time_signature_spinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        app:layout_constraintStart_toEndOf="@id/label_time_sig"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/label_time_sig"
        app:layout_constraintBottom_toBottomOf="@id/label_time_sig"
        android:layout_marginStart="8dp" />

    <Button
        android:id="@+id/btn_start_stop"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:text="@string/btn_start_metronome"
        android:textSize="24sp"
        android:backgroundTint="@android:color/holo_green_dark"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/colorSurface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_to_metronome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_metronome"
            android:textSize="11sp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="?attr/colorPrimary" />

        <Button
            android:id="@+id/btn_to_tuner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_tuner"
            android:textSize="11sp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="@color/gray_medium" />

        <Button
            android:id="@+id/btn_to_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_settings"
            android:textSize="11sp"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="@color/gray_medium"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>